<script>
  function initPanelSwitcher() {
    const switcher = document.querySelector('#panel .psw');
    if (!switcher) return;

    let indicator = switcher.querySelector('.psw-indicator');
    if (!indicator) {
      indicator = document.createElement('div');
      indicator.className = 'psw-indicator';
      switcher.prepend(indicator);
    }

    const buttons = Array.from(switcher.querySelectorAll('.psw-btn'));
    const panels = Array.from(document.querySelectorAll('#panel .panel-window'));

    function moveIndicator(btn) {
      indicator.style.left   = btn.offsetLeft + 'px';
      indicator.style.top    = btn.offsetTop  + 'px';
      indicator.style.width  = btn.offsetWidth  + 'px';
      indicator.style.height = btn.offsetHeight + 'px';
    }

    function activate(btn) {
      buttons.forEach(b => b.classList.remove('psw-active'));
      btn.classList.add('psw-active');
      moveIndicator(btn);

      const targetId = btn.dataset.target;
      panels.forEach(panel => {
        const visible = panel.id === targetId;
        panel.classList.toggle('panel-w-hidden', !visible);
        panel.classList.toggle('panel-w-in', visible);
      });
    }

    buttons.forEach(btn => btn.addEventListener('click', () => activate(btn)));

    const initial = switcher.querySelector('.psw-active') as HTMLElement;
    if (initial) requestAnimationFrame(() => moveIndicator(initial));
  }

  document.addEventListener('astro:page-load', initPanelSwitcher);
</script>
