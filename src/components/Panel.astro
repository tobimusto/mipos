---
import PanelSwitcher from './PanelSwitcher.tsx';
---
<!-- PANEL PREVIEW -->
<section class="panel-section" id="panel">
<div class="wrap">
  <header class="sec-head" data-reveal>
    <h2>Pensado para <span class="hl">vos.</span></h2>
    <p class="sec-sub">Las dos pantallas que vas a usar todos los días. El POS para registrar cada venta y los Reportes para entender tu negocio de un vistazo.</p>
  </header>

  <div data-reveal style="display:flex;justify-content:center">
    <PanelSwitcher client:visible />
  </div>

  <!-- ── REPORTES ── -->
  <div class="panel-window panel-w-in" id="panel-rep" role="img" aria-label="Vista del panel de mipos en la pantalla de Reportes: ingresos del período, ganancia estimada, total de ventas y ticket promedio, con un gráfico de ingresos por día y el estado de caja.">
    <div class="panel-chrome">
      <span class="pc-dot"></span><span class="pc-dot"></span><span class="pc-dot"></span>
      <div class="panel-url">app.mipos.online/reportes</div>
    </div>
    <div class="panel-app">
      <aside class="panel-side">
        <div class="ps-brand">
          <div class="ps-brand-logo">
            <svg width="20" height="20" viewBox="0 0 64 64" fill="none"><rect width="64" height="64" rx="17" fill="transparent"/><polyline points="17,32 27,43 47,22" stroke="white" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ps-brand-meta"><strong>mipos</strong><span>#De91 · Propietario</span></div>
        </div>
        <nav class="ps-nav">
          <div class="ps-group">
            <p>Operación</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>Punto de Venta</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/></svg>Compras</span>
          </div>
          <div class="ps-group">
            <p>Catálogo</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>Productos</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16"/></svg>Movimientos</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>Mi Tienda Online</span>
          </div>
          <div class="ps-group">
            <p>Personas</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>Clientes</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M20 7h-9m3-3-3 3 3 3M4 17h9m-3 3 3-3-3-3"/></svg>Proveedores</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><circle cx="19" cy="11" r="2"/></svg>Usuarios</span>
          </div>
          <div class="ps-group">
            <p>Análisis</p>
            <span class="ps-item active"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M18 17V9M13 17V5M8 17v-3"/></svg>Reportes</span>
          </div>
          <div class="ps-group">
            <p>Sistema</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>Configuración<span class="ps-chevron">›</span></span>
          </div>
        </nav>
        <div class="ps-caja">
          <div class="ps-caja-head">
            <span><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg> Mi Caja</span>
            <span class="ps-badge">Abierta</span>
          </div>
          <div class="ps-caja-amt">Mi efectivo: <strong>$48.500</strong></div>
          <div class="ps-caja-btn">Gestionar caja</div>
        </div>
        <div class="ps-user">
          <div class="ps-user-av">M</div>
          <div class="ps-user-meta"><strong>Marco A.</strong><span>Propietario</span></div>
          <svg class="ps-user-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </div>
      </aside>

      <main class="panel-main">
        <div class="pm-head">
          <div><h3>Reportes</h3><p>Rendimiento del negocio</p></div>
          <div class="pm-presets">
            <span class="pm-preset pm-preset-on">1 mes</span>
            <span class="pm-preset">2 sem</span>
            <span class="pm-preset">1 sem</span>
            <span class="pm-chip-limpiar">Limpiar</span>
          </div>
        </div>
        <div class="pm-stats">
          <div class="pm-stat">
            <span class="pm-kpi-lbl">Ingresos del período</span>
            <strong class="pm-kpi-val" data-count="1284500" data-prefix="$">$1.284.500</strong>
            <span class="pm-delta pm-delta-up">↑ 12% vs mes ant.</span>
          </div>
          <div class="pm-stat">
            <span class="pm-kpi-lbl">Ganancia estimada (30%)</span>
            <strong class="pm-kpi-val" data-count="385350" data-prefix="$">$385.350</strong>
            <span class="pm-delta pm-delta-up">↑ 8% vs mes ant.</span>
          </div>
          <div class="pm-stat">
            <span class="pm-kpi-lbl">Total de ventas</span>
            <strong class="pm-kpi-val" data-count="1842">1.842</strong>
            <span class="pm-delta pm-delta-up">↑ 15% vs mes ant.</span>
          </div>
          <div class="pm-stat">
            <span class="pm-kpi-lbl">Ticket promedio</span>
            <strong class="pm-kpi-val" data-count="697" data-prefix="$">$697</strong>
            <span class="pm-delta pm-delta-down">↓ 3% vs mes ant.</span>
          </div>
        </div>
        <div class="pm-tabs">
          <span class="active">Resumen</span>
          <span>Productos</span>
          <span>Ventas</span>
          <span>Caja</span>
        </div>
        <div class="pm-grid">
          <div class="pm-left-col">
          <div class="pm-card pm-chart">
            <div class="pmc-head">
              Ingresos por día
              <div class="pmc-legend">
                <span class="pmc-dot" style="background:#6366f1"></span>Ingresos
                <span class="pmc-dot" style="background:#22c55e"></span>Ganancia
              </div>
            </div>
            <div class="pm-bars-2">
              <div class="pm-bg"><span class="bi" style="height:42%"></span><span class="bg" style="height:28%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:58%"></span><span class="bg" style="height:38%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:48%"></span><span class="bg" style="height:32%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:72%"></span><span class="bg" style="height:48%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:65%"></span><span class="bg" style="height:43%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:88%"></span><span class="bg" style="height:58%"></span></div>
              <div class="pm-bg"><span class="bi" style="height:79%"></span><span class="bg" style="height:53%"></span></div>
            </div>
          </div>
          <div class="pm-card">
            <div class="pmc-head">Pendientes</div>
            <div class="pm-pend-row">
              <span class="pm-pend-dot" style="background:var(--pgrn)"></span>
              <span class="pm-pend-lbl">A cobrar</span>
              <span class="pm-pend-sub">3 clientes con fiado</span>
              <span class="pm-pend-amt" style="color:var(--pgrn)">+$23.700</span>
            </div>
            <div class="pm-pend-row">
              <span class="pm-pend-dot" style="background:#ff7a7a"></span>
              <span class="pm-pend-lbl">A pagar</span>
              <span class="pm-pend-sub">2 proveedores</span>
              <span class="pm-pend-amt" style="color:#ff7a7a">-$45.200</span>
            </div>
          </div>
          </div>
          <div class="pm-right-col">
            <div class="pm-card">
              <div class="pmc-head">Medios de pago</div>
              <div class="pm-pay-row">
                <span class="pm-pay-dot" style="background:#22c55e"></span>
                <span class="pm-pay-name">Efectivo</span>
                <div class="pm-pay-bar-wrap"><div class="pm-pay-bar" style="width:67%;background:#22c55e"></div></div>
                <span class="pm-pay-amt">$867.500</span>
              </div>
              <div class="pm-pay-row">
                <span class="pm-pay-dot" style="background:#6366f1"></span>
                <span class="pm-pay-name">Transferencia</span>
                <div class="pm-pay-bar-wrap"><div class="pm-pay-bar" style="width:27%;background:#6366f1"></div></div>
                <span class="pm-pay-amt">$341.200</span>
              </div>
              <div class="pm-pay-row">
                <span class="pm-pay-dot" style="background:#f59e0b"></span>
                <span class="pm-pay-name">Tarjeta</span>
                <div class="pm-pay-bar-wrap"><div class="pm-pay-bar" style="width:6%;background:#f59e0b"></div></div>
                <span class="pm-pay-amt">$75.800</span>
              </div>
            </div>
            <div class="pm-card">
              <div class="pmc-head">Estado de Caja <strong style="color:var(--pind)">$48.500</strong></div>
              <ul class="pm-rows">
                <li><span>09:12</span><span>Apertura</span><span class="amt">$15.000</span></li>
                <li><span>13:40</span><span>Ingreso</span><span class="amt up">+$28.300</span></li>
                <li><span>16:05</span><span>Retiro</span><span class="amt down">−$5.000</span></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="pm-time-grid">
          <div class="pm-card">
            <div class="pmc-head">Ventas por hora</div>
            <div class="pm-mini-bars">
              <span class="b lo"  style="height:3%"></span>
              <span class="b lo"  style="height:1%"></span>
              <span class="b"     style="height:22%"></span>
              <span class="b"     style="height:18%"></span>
              <span class="b"     style="height:28%"></span>
              <span class="b"     style="height:24%"></span>
              <span class="b"     style="height:38%"></span>
              <span class="b peak"style="height:100%"></span>
              <span class="b"     style="height:82%"></span>
              <span class="b"     style="height:62%"></span>
              <span class="b"     style="height:44%"></span>
              <span class="b lo"  style="height:14%"></span>
            </div>
            <div class="pm-mini-lbls">
              <span>0h</span><span>2h</span><span>4h</span><span>6h</span>
              <span>8h</span><span>10h</span><span>12h</span><span>14h</span>
              <span>16h</span><span>18h</span><span>20h</span><span>22h</span>
            </div>
          </div>
          <div class="pm-card">
            <div class="pmc-head">Ventas por día</div>
            <div class="pm-mini-bars">
              <span class="b"     style="height:62%"></span>
              <span class="b"     style="height:68%"></span>
              <span class="b"     style="height:65%"></span>
              <span class="b"     style="height:72%"></span>
              <span class="b"     style="height:82%"></span>
              <span class="b peak"style="height:100%"></span>
              <span class="b"     style="height:90%"></span>
            </div>
            <div class="pm-mini-lbls">
              <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span>
              <span>Vie</span><span>Sáb</span><span>Dom</span>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- ── POS ── -->
  <div class="panel-window panel-w-hidden" id="panel-pos" role="img" aria-label="Vista del Punto de Venta de mipos: venta en curso con grilla de productos, carrito y botón de cobro.">
    <div class="panel-chrome">
      <span class="pc-dot"></span><span class="pc-dot"></span><span class="pc-dot"></span>
      <div class="panel-url">app.mipos.online/pos</div>
    </div>
    <div class="panel-app">
      <aside class="panel-side">
        <div class="ps-brand">
          <div class="ps-brand-logo">
            <svg width="20" height="20" viewBox="0 0 64 64" fill="none"><rect width="64" height="64" rx="17" fill="transparent"/><polyline points="17,32 27,43 47,22" stroke="white" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ps-brand-meta"><strong>mipos</strong><span>#De91 · Propietario</span></div>
        </div>
        <nav class="ps-nav">
          <div class="ps-group">
            <p>Operación</p>
            <span class="ps-item active"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>Punto de Venta</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/></svg>Compras</span>
          </div>
          <div class="ps-group">
            <p>Catálogo</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>Productos</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16"/></svg>Movimientos</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>Mi Tienda Online</span>
          </div>
          <div class="ps-group">
            <p>Personas</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>Clientes</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M20 7h-9m3-3-3 3 3 3M4 17h9m-3 3 3-3-3-3"/></svg>Proveedores</span>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><circle cx="19" cy="11" r="2"/></svg>Usuarios</span>
          </div>
          <div class="ps-group">
            <p>Análisis</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M18 17V9M13 17V5M8 17v-3"/></svg>Reportes</span>
          </div>
          <div class="ps-group">
            <p>Sistema</p>
            <span class="ps-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>Configuración<span class="ps-chevron">›</span></span>
          </div>
        </nav>
        <div class="ps-caja">
          <div class="ps-caja-head">
            <span><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg> Mi Caja</span>
            <span class="ps-badge">Abierta</span>
          </div>
          <div class="ps-caja-amt">Mi efectivo: <strong>$48.500</strong></div>
          <div class="ps-caja-btn">Gestionar caja</div>
        </div>
        <div class="ps-user">
          <div class="ps-user-av">M</div>
          <div class="ps-user-meta"><strong>Marco A.</strong><span>Propietario</span></div>
          <svg class="ps-user-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </div>
      </aside>

      <main class="pos-main">
        <div class="pos-topbar">
          <div class="pos-search-wrap">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            Buscar producto o escanear código…
          </div>
          <button class="pos-monto-btn" type="button">+ Monto</button>
        </div>
        <div class="pos-body">
          <div class="pos-center">
            <div class="pos-carrito-hd">
              <div><strong>Carrito</strong><small>3 productos</small></div>
              <span class="pos-vaciar">Vaciar</span>
            </div>
            <div class="pos-ci-list">
              <div class="pos-ci">
                <img class="pos-ci-img" src="https://images.unsplash.com/photo-1567103472667-6898f3a79cf2?w=48&h=48&fit=crop&crop=center&auto=format&q=80" width="42" height="42" loading="lazy" alt="Coca Cola 2.25L">
                <div class="pos-ci-info"><span class="pos-ci-name">Coca Cola 2.25L</span><span class="pos-ci-unit">$1.900 c/u</span></div>
                <div class="pos-ci-ctrl"><b>−</b> 2 Unitario <b>+</b></div>
                <span class="pos-ci-total">$3.800</span>
              </div>
              <div class="pos-ci">
                <img class="pos-ci-img" src="https://images.unsplash.com/photo-1481391319762-47dff72954d9?w=48&h=48&fit=crop&crop=center&auto=format&q=80" width="42" height="42" loading="lazy" alt="Alfajor Havanna">
                <div class="pos-ci-info"><span class="pos-ci-name">Alfajor Havanna</span><span class="pos-ci-unit">$1.200 c/u</span></div>
                <div class="pos-ci-ctrl"><b>−</b> 1 Unitario <b>+</b></div>
                <span class="pos-ci-total">$1.200</span>
              </div>
              <div class="pos-ci">
                <img class="pos-ci-img" src="https://images.unsplash.com/photo-1680627542594-1f57af98a5fb?w=48&h=48&fit=crop&crop=center&auto=format&q=80" width="42" height="42" loading="lazy" alt="Agua mineral 1.5L">
                <div class="pos-ci-info"><span class="pos-ci-name">Agua mineral 1.5L</span><span class="pos-ci-unit">$800 c/u</span></div>
                <div class="pos-ci-ctrl"><b>−</b> 3 Unitario <b>+</b></div>
                <span class="pos-ci-total">$2.400</span>
              </div>
            </div>
          </div>
          <div class="pos-right">
            <div class="pos-rsec">
              <div class="pos-slbl">Condición IVA</div>
              <div class="pos-drop">Consumidor Final <span>▼</span></div>
              <div class="pos-slbl">Cliente (opcional)</div>
              <div class="pos-drop">Ninguno (Venta mostrador) <span>▼</span></div>
            </div>
            <div class="pos-rsec">
              <div class="pos-slbl">Resumen</div>
              <div class="pos-res-row"><span>Subtotal:</span><span>$7.400</span></div>
              <div class="pos-res-row grn"><span>Descuento (efectivo):</span><span>−$370</span></div>
              <div class="pos-res-ttl"><span>Total:</span><span class="pos-total-big">$7.030</span></div>
            </div>
            <div class="pos-rsec">
              <div class="pos-slbl">Método de pago</div>
              <div class="pos-mets">
                <button class="pos-met on" type="button"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Efectivo</button>
                <button class="pos-met" type="button"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Tarjeta</button>
                <button class="pos-met" type="button"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>QR / Transf.</button>
                <button class="pos-met" type="button"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Fiado</button>
              </div>
            </div>
            <button class="pos-mipos" type="button">Cobrar $7.030</button>
          </div>
        </div>
      </main>
    </div>
