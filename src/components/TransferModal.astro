---
const { content } = Astro.props;
---
<style>
.tr-modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.tr-modal-overlay.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.tr-modal {
  background: var(--bg);
  width: 90%;
  max-width: 400px;
  border-radius: var(--r-md);
  padding: 24px;
  position: relative;
  box-shadow: 0 12px 32px rgba(0,0,0,0.2);
  transform: translateY(20px);
  transition: transform 0.3s ease;
  border: 1px solid var(--line);
}
.tr-modal-overlay.active .tr-modal {
  transform: translateY(0);
}
.tr-close {
  position: absolute;
  top: 16px; right: 16px;
  background: none; border: none;
  color: var(--ink-2);
  cursor: pointer;
  padding: 4px;
  border-radius: var(--r-sm);
}
.tr-close:hover { background: var(--panel); color: var(--ink); }
.tr-modal-body {
  background: var(--panel);
  border-radius: var(--r-sm);
  padding: 16px;
  margin: 16px 0;
  border: 1px solid var(--line);
  display: flex; flex-direction: column; gap: 12px;
}
.tr-data-group {
  display: flex; flex-direction: column; gap: 4px;
}
.tr-label {
  font-size: 11px; font-weight: 700; color: var(--brand); letter-spacing: 0.05em;
}
.tr-data-group strong {
  font-size: 15px; color: var(--ink); font-weight: 600;
}
.tr-copy-row {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg); padding: 8px 12px; border-radius: var(--r-sm);
  border: 1px solid var(--line);
}
.tr-copy-row button {
  background: var(--brand-tint); color: var(--brand);
  border: none; border-radius: 4px; padding: 6px; cursor: pointer;
}
.tr-copy-row button:hover { background: var(--brand); color: white; }
.tr-modal-footer p {
  font-size: 13px; color: var(--ink-2); margin: 0 0 16px 0; line-height: 1.4;
}
</style>
<div class="tr-modal-overlay" id="transferModal"
  data-wa={content.whatsapp}
  data-symbol={content.currency.symbol}
  data-locale={content.locale}
  onclick="if(event.target===this)closeTransferModal()">
  <div class="tr-modal">
    <button class="tr-close" onclick="closeTransferModal()" aria-label="Cerrar"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    
    <div class="tr-modal-header">
      <h3 style="font-family:var(--font-display);font-size:20px;font-weight:700;margin:0 0 8px;">Adquirir plan</h3>
      <p style="color:var(--ink-3);font-size:14px;margin:0;">Contactanos para activar tu plan.</p>
    </div>

    <div class="tr-modal-body">
      <div class="tr-data-group">
        <span class="tr-label">PLAN SELECCIONADO</span>
        <strong style="color:var(--brand); font-size:16px;">Plan <span id="transferModalPlan">Esencial</span> <span style="color:var(--ink-2);font-size:14px;font-weight:500;">(Valor: <span id="transferModalAmount">$15.000</span>)</span></strong>
      </div>
    </div>

    <div class="tr-modal-footer">
      <a href="#" id="waContactBtn" target="_blank" rel="noopener" class="btn btn-orange" style="width:100%; justify-content:center; display:flex; gap:8px; margin-top:0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
        Contactar por WhatsApp
      </a>
    </div>
  </div>
</div>
<script is:inline>
function openTransferModal(btn) {
  const modal = document.getElementById('transferModal');
  const waNumber = modal.dataset.wa;
  const symbol = modal.dataset.symbol;
  const locale = modal.dataset.locale;

  if (btn) {
    const article = btn.closest('article');
    if (article) {
      const planName = article.querySelector('.ptag-name').innerText;
      const isAnual = document.getElementById('btnAnual') && document.getElementById('btnAnual').classList.contains('active');
      let amount = '';
      const priceSpan = article.querySelector('.plan-p');
      if (priceSpan) {
        if (isAnual) {
          amount = symbol + (parseInt(priceSpan.dataset.a) * 12).toLocaleString(locale);
        } else {
          amount = symbol + parseInt(priceSpan.dataset.m).toLocaleString(locale);
        }
      }
      document.getElementById('transferModalPlan').innerText = planName + (isAnual ? ' (Anual)' : ' (Mensual)');
      document.getElementById('transferModalAmount').innerText = amount;

      const whatsappMsg = `Hola! Quiero adquirir el plan ${planName} ${isAnual ? 'Anual' : 'Mensual'} de mipos.`;
      document.getElementById('waContactBtn').href = `https://wa.me/${waNumber}?text=${encodeURIComponent(whatsappMsg)}`;
    }
  }
  modal.classList.add('active');
}
function closeTransferModal() { document.getElementById('transferModal').classList.remove('active'); }
</script>
