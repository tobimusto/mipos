---
const { content } = Astro.props;
---
  <div class="tck-dots" id="tckDots" role="group" aria-label="Ir a opinión"></div>
</div>
</section>

<!-- WHATSAPP CHAT -->
<section class="wa-section" id="soporte">
<div class="wrap wa-grid">
  <div class="wa-copy" data-reveal>
    <span class="sec-kicker" style="display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--brand);margin-bottom:16px;padding:4px 12px;border:1px solid var(--brand-tint-2);border-radius:99px;background:var(--brand-tint)">Soporte real</span>
    <h2 style="font-family:var(--font-display);font-size:clamp(26px,3.2vw,40px);font-weight:780;line-height:1.1;letter-spacing:-.03em;margin-bottom:14px;color:var(--ink)">Un equipo real<br/>que te responde.</h2>
    <p>Sin bots ni formularios. Te acompañamos desde el primer día por WhatsApp, también fuera del horario de oficina.</p>
    
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin-top:20px;">
      <a href={`https://wa.me/${content.whatsapp}?text=Hola%2C%20me%20interesa%20mipos%20para%20mi%20negocio.`} target="_blank" rel="noopener noreferrer" class="btn btn-orange btn-lg" style="display:inline-flex;align-items:center;gap:8px;margin-top:0;width:100%;justify-content:center;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.121 1.532 5.848L0 24l6.335-1.611A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.372l-.36-.214-3.727.977.994-3.634-.235-.374A9.818 9.818 0 1 1 12 21.818z"/></svg>
          Escribinos por WhatsApp
        </a>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=miposonlinecontacto@gmail.com&su=CONTACTO%20ONLINE%3A%20MIPOS" onclick="window.open(this.href, 'gmailPopup', 'width=600,height=600,scrollbars=yes,resizable=yes'); return false;" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg" style="display:inline-flex;align-items:center;gap:8px;margin-top:0;width:100%;justify-content:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7"/><rect x="3" y="5" width="18" height="14" rx="2" stroke-width="2"/></svg>
          Enviar email
        </a>
        <a href="https://instagram.com/mipos.online" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg" style="display:inline-flex;align-items:center;gap:8px;margin-top:0;width:100%;justify-content:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          Seguinos en Instagram
        </a>
      </div>
  </div>
  <div class="wa-phone" data-reveal>
    <div class="wa-device">
      <!-- Header -->
      <div class="wa-header">
        <span class="wa-back" aria-hidden="true">
          <svg width="9" height="16" viewBox="0 0 9 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1 1 8l7 7"/></svg>
        </span>
        <div class="wa-av" aria-hidden="true">C</div>
        <div class="wa-contact-info">
          <span class="wa-contact-name">
            <span class="wa-contact-name-txt">mipos Soporte</span>
            <span class="wa-verified" aria-label="Verificado">
              <svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#25d366"/><path d="M7 12.5l3.5 3.5 6.5-7" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
          <span class="wa-contact-status">en línea</span>
        </div>
        <div class="wa-header-icons" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10l5-3v10l-5-3z"/><rect x="2" y="6" width="13" height="12" rx="2.5"/></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3l1.5 4.5L7.5 11a12 12 0 0 0 5.5 5.5l2.5-2 4.5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
        </div>
      </div>
      <!-- Messages -->
      <div class="wa-msgs" id="waMessages" role="log" aria-label="Conversación de soporte">
        <div class="wa-date-chip"><span>HOY</span></div>
      </div>
      <!-- Input bar -->
      <div class="wa-input-bar">
        <div class="wa-input-field" aria-hidden="true">Escribí un mensaje…</div>
        <div class="wa-input-send" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 6l6 6-6 6"/></svg>
        </div>
