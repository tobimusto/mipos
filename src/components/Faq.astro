---
import FaqSplit from './FaqSplit.tsx';
---
<!-- FAQ -->
<section class="faq" id="faq">
<div class="wrap">
  <header class="sec-head" data-reveal style="margin-bottom: clamp(32px,4vw,52px)">
    <h2>Preguntas <span class="hl">que nos hacen.</span></h2>
  </header>
  <div data-reveal>
    <FaqSplit client:visible />
  </div>
</div>
</section>

<style is:global>
/* ── Split FAQ ── */
.faqsp {
  display: grid;
  grid-template-columns: 2fr 3fr;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

/* ── Question list ── */
.faqsp-list {
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.faqsp-q {
  position: relative;
  text-align: left;
  padding: 16px 20px 16px 24px;
  border: none;
  border-bottom: 1px solid var(--line);
  background: transparent;
  cursor: pointer;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 500;
  color: var(--ink-2);
  line-height: 1.45;
  transition: background 0.15s, color 0.15s;
}
.faqsp-q:last-child { border-bottom: none; }
.faqsp-q:hover:not(.faqsp-q--on) { background: var(--panel); color: var(--ink); }

/* Active indicator — left accent bar */
.faqsp-q::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: transparent;
  transition: background 0.15s;
}
.faqsp-q--on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
}
.faqsp-q--on::before { background: var(--brand); }

/* ── Answer panel ── */
.faqsp-panel {
  padding: clamp(28px, 3.5vw, 44px);
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-height: 280px;
}

.faqsp-qtitle {
  font-family: var(--font-display);
  font-size: clamp(18px, 2vw, 22px);
  font-weight: 740;
  letter-spacing: -0.025em;
  line-height: 1.2;
  color: var(--ink);
  animation: faq-in 240ms cubic-bezier(0.16,1,0.3,1) both;
}
.faqsp-atext {
  font-size: 15.5px;
  line-height: 1.72;
  color: var(--ink-2);
  text-wrap: pretty;
  flex: 1;
  animation: faq-in 240ms cubic-bezier(0.16,1,0.3,1) 50ms both;
}

@keyframes faq-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}

/* CTA strip at bottom of panel */
.faqsp-cta {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--line-2);
  font-size: 13px;
  color: var(--ink-3);
  margin-top: auto;
}
.faqsp-wa {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #16a34a;
  text-decoration: none;
  padding: 5px 12px;
  border: 1px solid rgba(22,163,74,.25);
  border-radius: 99px;
  background: rgba(22,163,74,.06);
  transition: background 0.15s, border-color 0.15s;
  white-space: nowrap;
}
.faqsp-wa:hover { background: rgba(22,163,74,.12); border-color: rgba(22,163,74,.4); }

/* ── Responsive ── */
@media (max-width: 720px) {
  .faqsp { grid-template-columns: 1fr; }
  .faqsp-list { border-right: none; border-bottom: 1px solid var(--line); }
  .faqsp-q { padding: 14px 16px 14px 20px; }
  .faqsp-panel { min-height: auto; padding: 24px 20px; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .faqsp-qtitle, .faqsp-atext { animation: none; }
}
</style>
