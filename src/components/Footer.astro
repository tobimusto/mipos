---
const { content } = Astro.props;
---
<!-- FOOTER -->
<footer>
<div class="wrap footer-inner">
  <div class="footer-brand">
    <a href="#" class="logo" aria-label="mipos, inicio">
      <div style="display:flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:8px; overflow:hidden;">
        <svg width="30" height="30" viewBox="0 0 64 64" fill="none">
          <rect width="64" height="64" rx="17" fill="#2563EB"/>
          <polyline points="17,32 27,43 47,22" stroke="white" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="logo-name" style="font-family:var(--font-display); text-transform:lowercase; font-size:22px; margin-left:-2px;">mipos</span>
    </a>
    <p>{content.footer.tagline}</p>
    <a href={`https://instagram.com/${content.support.instagram}`} target="_blank" rel="noopener noreferrer" class="footer-ig">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor" stroke="none"/></svg>
      @{content.support.instagram}
    </a>
  </div>
  <div class="footer-col footer-col-wide">
    <h4>Producto</h4>
    <ul class="footer-col-grid">
      <li><a href="#panel">Qué hace</a></li>
      <li><a href="#ahorro">Ahorrá tiempo</a></li>
      <li><a href="#compare">Comparar</a></li>
      <li><a href="#pricing">Precios</a></li>
      <li><a href="#faq">Preguntas</a></li>
      <li><a href="#soporte">Contacto</a></li>
    </ul>
  </div>
  <div class="footer-col">
    <h4>Legal</h4>
    <ul>
      <li><a href={content.legalHref}>Términos y Condiciones</a></li>
    </ul>
  </div>
</div>
<div class="wrap footer-bottom">
  <span>© 2026 mipos · Todos los derechos reservados</span>
  <a href="https://codetm.site" target="_blank" rel="noopener noreferrer" class="by-codetm">Desarrollado por <strong>CodeTM</strong></a>
</div>
</footer>
